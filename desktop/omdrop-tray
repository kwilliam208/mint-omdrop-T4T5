        self.stack.add_named(files, "files")

        # Step 2: the devices, filling in as they answer.
        devices = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8)
        searching = Gtk.Box(spacing=8)
        self.spinner = Gtk.Spinner()
        searching.pack_start(self.spinner, False, False, 0)
        self.search_label = Gtk.Label(label="Looking for devices…", xalign=0, wrap=True)
        self.search_label.set_max_width_chars(1)
        self.search_label.get_style_context().add_class("omdrop-dim")
        searching.pack_start(self.search_label, True, True, 0)
        devices.pack_start(searching, False, False, 0)
        # A checkbox per device: one send can go to several, one after another.
        self.devices_list = Gtk.ListBox()
        self.devices_list.set_selection_mode(Gtk.SelectionMode.NONE)
        self.devices_list.set_activate_on_single_click(True)
        self.devices_list.connect("row-activated", self.on_row_activated)
        dev_scroller = Gtk.ScrolledWindow()
        dev_scroller.set_policy(Gtk.PolicyType.NEVER, Gtk.PolicyType.AUTOMATIC)
        dev_scroller.set_min_content_height(120)
        dev_scroller.set_max_content_height(220)
        dev_scroller.add(self.devices_list)
        devices.pack_start(dev_scroller, False, False, 0)
        hint = Gtk.Label(xalign=0, wrap=True, label=(
            "On the iPhone, set receiving to Everyone for 10 Minutes and keep it unlocked."))
        hint.set_max_width_chars(1)
        hint.get_style_context().add_class("omdrop-dim")
        devices.pack_start(hint, False, False, 0)
        self.stack.add_named(devices, "devices")

        buttons = Gtk.Box(spacing=6)
        self.back = Gtk.Button(label="Cancel")
        self.back.connect("clicked", self.on_back)
        buttons.pack_start(self.back, False, False, 0)
        self.next = Gtk.Button(label="Next")
        self.next.get_style_context().add_class("suggested-action")
        self.next.connect("clicked", self.on_next)
        buttons.pack_end(self.next, False, False, 0)
        card.pack_start(buttons, False, False, 2)

        self.connect("key-press-event", self.on_key)
        self.connect("delete-event", lambda *_: self.cancel() or True)
        card.show_all()
        self.show_files()

    # -- step 1

    def show_files(self, results=None):
        for row in self.files_list.get_children():
            self.files_list.remove(row)
        # Once checked, the files that can't go come first, where they're seen.
        order = sorted(self.paths, key=lambda p: not results.get(p)) if results else self.paths
        home = os.path.expanduser("~")
        for path in order:
            problem = results.get(path) if results else None
            row = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=1)
            top = Gtk.Box(spacing=8)
            name = Gtk.Label(label=os.path.basename(path), xalign=0)
            name.set_ellipsize(3)   # Pango.EllipsizeMode.END
            top.pack_start(name, True, True, 0)
            size = Gtk.Label(xalign=1)
            size.get_style_context().add_class("omdrop-num")
            if os.path.isfile(path):
                try:
                    size.set_text(format_size(os.path.getsize(path)))
                except OSError:
                    pass
            top.pack_end(size, False, False, 0)
            row.pack_start(top, False, False, 0)
            folder = os.path.dirname(path)
            if folder == home or folder.startswith(home + os.sep):
                folder = "~" + folder[len(home):]
            where = Gtk.Label(label=folder, xalign=0)
            where.set_ellipsize(1)  # Pango.EllipsizeMode.START
            where.get_style_context().add_class("omdrop-dim")
            row.pack_start(where, False, False, 0)
            if results is not None:
                verdict = Gtk.Label(xalign=0, label=f"✗ Can't send: {problem}" if problem else "✓ Ready")
                verdict.get_style_context().add_class("omdrop-error" if problem else "omdrop-ok")
                row.pack_start(verdict, False, False, 0)
            self.files_list.add(row)
        self.files_list.show_all()
        total = len(self.paths)
        self.files_note.set_text("" if results is None else
                                 f"{sum(1 for p in self.paths if results.get(p))} of {total} can't be "
                                 "sent. Remove them or choose again." if any(results.values()) else "")
        self.files_note.get_style_context().add_class("omdrop-error")
        self.files_note.set_visible(bool(self.files_note.get_text()))
        self.stack.set_visible_child_name("files")
        self.step.set_text(f"{format_files(total)} · step 1 of 2")
        self.back.set_label("Cancel")
        self.next.set_label("Next")
        self.update_buttons()
        self.refit()

    def on_next(self, _button):
        if self.stack.get_visible_child_name() == "devices":
            self.on_send()
            return
        results = check_files(self.paths)
        if any(results.values()):
            failed = [p for p in self.paths if results[p]]
            if self.next.get_label() == "Remove and Next":
                self.paths = [p for p in self.paths if p not in failed]
                if not self.paths:
                    self.cancel()
                    return
                self.show_files()
                return
            self.show_files(results)
            if len(failed) < len(self.paths):
                self.next.set_label("Remove and Next")
            return
        self.show_devices()

    # -- step 2

    def show_devices(self):
        self.stack.set_visible_child_name("devices")
        self.step.set_text(f"{format_files(len(self.paths))} · step 2 of 2")
        self.back.set_label("Back")
        self.next.set_label("Send")
        self.spinner.start()
        self.update_buttons()
        self.refit()

    def add_peer(self, peer):
        key = peer.get("address")
        if not key:
            return
        if key in self.peers:
            old, row = self.peers[key]
            if peer.get("name") or not old.get("name"):
                row.get_child().get_children()[0].set_text(peer_label(peer))
                self.peers[key] = (peer, row)
            return
        line = Gtk.Box(spacing=10)
        line.pack_start(Gtk.Label(label=peer_label(peer), xalign=0), True, True, 0)
        check = Gtk.CheckButton()
        check.connect("toggled", lambda *_: self.update_buttons())
        line.pack_end(check, False, False, 0)
        row = Gtk.ListBoxRow()
        row.add(line)
        row.show_all()
        self.devices_list.add(row)
        self.peers[key] = (peer, row)
        self.search_label.set_text(
            f"{len(self.peers)} found. Still looking…" if len(self.peers) != 1 else "1 found. Still looking…")
        self.update_buttons()

    def set_search_status(self, text, busy=True):
        if busy and self.peers:
            return      # the count of devices found says more
        self.search_label.set_text(text)
        (self.spinner.start if busy else self.spinner.stop)()
        self.refit()

    @staticmethod
    def row_check(row):
        return row.get_child().get_children()[-1]

    def on_row_activated(self, _list, row):
        check = self.row_check(row)
        check.set_active(not check.get_active())

    def chosen_peers(self):
        """The ticked devices, in the order they appeared."""
        return [peer for peer, row in self.peers.values() if self.row_check(row).get_active()]

    def on_send(self):
        peers = self.chosen_peers()
        if not peers or self.stack.get_visible_child_name() != "devices":
            return
        self.tray.start_send(peers, list(self.paths))
        self.destroy()

    # -- both

    def update_buttons(self):
        if self.stack.get_visible_child_name() == "devices":
            n = len(self.chosen_peers())
            self.next.set_sensitive(n > 0)
            self.next.set_label(f"Send to {n}" if n > 1 else "Send")
        else:
            self.next.set_sensitive(bool(self.paths))

    def on_back(self, _button):
        if self.stack.get_visible_child_name() == "devices":
            self.spinner.stop()
            self.show_files()
        else:
            self.cancel()

    def on_key(self, _w, event):
        if event.keyval == Gdk.KEY_Escape:
            self.cancel()
        return False

    def cancel(self):
        self.tray.end_discovery(abandoned=True)
        self.destroy()


def run_streaming(args, on_line, on_done, env=None):
    """Run args with OMDROP_GUI=1 (privileged steps ask through polkit), each
    output line to on_line, then on_done(exit status)."""
    launcher = Gio.SubprocessLauncher.new(Gio.SubprocessFlags.STDOUT_PIPE | Gio.SubprocessFlags.STDERR_MERGE)
    launcher.setenv("OMDROP_GUI", "1", True)
    for key, value in (env or {}).items():
        launcher.setenv(key, value, True)
    try:
        proc = launcher.spawnv(args)
    except GLib.Error as e:
        on_line(e.message)
        on_done(1)
        return None
    # Done once the output has been read to its end and the process has exited.
    state = {"left": 2, "rc": 1}

    def one_more():
        state["left"] -= 1
        if state["left"] == 0:
            on_done(state["rc"])

    def exited(p, result):
        p.wait_finish(result)
        state["rc"] = p.get_exit_status() if p.get_if_exited() else 1
        one_more()
    read_lines(proc.get_stdout_pipe(), on_line, one_more)
    proc.wait_async(None, exited)
    return proc


