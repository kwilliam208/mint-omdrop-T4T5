def find_cli():
    # OMDROP_CLI points at another omdrop, such as a test stub.
    override = os.environ.get("OMDROP_CLI")
    if override:
        return override
    found = shutil.which("omdrop")
    if found:
        return found
    local = os.path.expanduser("~/.local/bin/omdrop")
    return local if os.access(local, os.X_OK) else None


def icon_path(state):
    """The full-colour icon, for the popup's header."""
    for d in ICON_DIRS:
        p = os.path.join(d, f"omdrop-{state}.svg")
        if os.path.exists(p):
            return p
    return "network-wireless"  # a themed stand-in if the SVGs are missing


def panel_icon(state):
    """Symbolic, so the panel sizes and colours it like its own icons; a file path if not installed."""
    name = f"omdrop-{state}-symbolic"
    if Gtk.IconTheme.get_default().has_icon(name):
        return name
    return icon_path(state)


# ------------------------------------------------------------ the send ring
# While sending, the icon is the glyph in a ring open at the top, filling
# clockwise in blue. Full colour (a symbolic icon can't hold blue), sized
# against the panel's symbolic size so it sits level with its neighbours.

RING_ACCENT = "#0A84FF"
RING_GAP_DEGREES = 50
# The symbolic glyph (desktop/icons/omdrop-on-symbolic.svg), 16 grid.
GLYPH_PATHS = (
    "M 4.375 14.279 A 7.25 7.25 0 1 1 11.625 14.279 L 10.875 12.980 "
    "A 5.75 5.75 0 1 0 5.125 12.980 Z",
    "M 5.875 11.681 A 4.25 4.25 0 1 1 10.125 11.681 L 9.375 10.382 "
    "A 2.75 2.75 0 1 0 6.625 10.382 Z",
    "M 8 7.6 L 10.1 15.5 L 5.9 15.5 Z",
)
# Against the symbolic size: a 20 px ring round an 11 px glyph beside 14 px icons.
RING_DIAMETER = 20 / 14
RING_STROKE = 2.3 / 14
RING_GLYPH = 11 / 14


def panel_icon_colour():
    """The colour Cinnamon draws symbolic panel icons in, from its theme."""
    try:
        theme = Gio.Settings.new("org.cinnamon.theme").get_string("name")
    except Exception:
        theme = ""
    for base in (os.path.expanduser("~/.themes"), os.path.expanduser("~/.local/share/themes"),
                 "/usr/share/themes"):
        css = os.path.join(base, theme, "cinnamon", "cinnamon.css")
        try:
            with open(css) as f:
                m = re.search(r"\.applet-icon\s*\{[^}]*?color:\s*(#[0-9a-fA-F]{3,8})", f.read())
        except OSError:
            continue
        if m:
            return m.group(1)
    return "#ffffff"


def _arc(c, r, a0, a1):
    def at(a):
        return c + r * math.cos(math.radians(a)), c + r * math.sin(math.radians(a))
    (x0, y0), (x1, y1) = at(a0), at(a1)
    large = 1 if (a1 - a0) % 360 > 180 else 0
    return f"M {x0:.3f} {y0:.3f} A {r:.3f} {r:.3f} 0 {large} 1 {x1:.3f} {y1:.3f}"


def ring_svg(progress, canvas, symbolic, fg, accent=RING_ACCENT):
    """The send-progress icon: progress 0..1, on a canvas px square."""
    c = canvas / 2
    stroke = symbolic * RING_STROKE
    r = (symbolic * RING_DIAMETER - stroke) / 2
    glyph = symbolic * RING_GLYPH
    start = -90 + RING_GAP_DEGREES / 2      # the gap's right edge
    sweep = 360 - RING_GAP_DEGREES
    paths = "".join(f'<path d="{d}"/>' for d in GLYPH_PATHS)
    parts = [
        f'<svg xmlns="http://www.w3.org/2000/svg" width="{canvas}" height="{canvas}" '
        f'viewBox="0 0 {canvas} {canvas}">',
        f'<g fill="{fg}" transform="translate({c - glyph / 2:.3f} {c - glyph / 2:.3f}) '
        f'scale({glyph / 16:.4f})">{paths}</g>',
        f'<path d="{_arc(c, r, start, start + sweep)}" fill="none" stroke="{fg}" '
        f'stroke-width="{stroke:.3f}" stroke-linecap="butt"/>',
    ]
    progress = max(0.0, min(1.0, progress))
    if progress > 0:
        parts.append(f'<path d="{_arc(c, r, start, start + max(sweep * progress, 1))}" '
                     f'fill="none" stroke="{accent}" stroke-width="{stroke:.3f}" '
                     f'stroke-linecap="butt"/>')
    parts.append("</svg>")
    return "".join(parts)


# ------------------------------------------------------------ sending files

def check_file(path):
    """None if path can be sent, else why not, in a few words."""
    try:
        name = os.path.basename(path)
        name.encode("utf-8")
    except UnicodeEncodeError:
        return "its name isn't valid UTF-8"
    try:
        st = os.stat(path)          # follows links: what the link points at
    except FileNotFoundError:
        return "it's a broken link" if os.path.lexists(path) else "it no longer exists"
    except PermissionError:
        return "permission denied"
    except OSError as e:
        return e.strerror or "can't be read"
    if stat.S_ISDIR(st.st_mode):
        return "it's a folder"
    if not stat.S_ISREG(st.st_mode):
        return "it's not a regular file"
    try:
        with open(path, "rb") as f:
            f.read(1)
    except PermissionError:
        return "permission denied"
    except OSError as e:
        return e.strerror or "can't be read"
    return None


def check_files(paths):
    """{path: None or why it can't be sent}, including omdrop's one-name-per-transfer rule."""
    results = {path: check_file(path) for path in paths}
    seen = {}
    for path in paths:
        name = os.path.basename(path)
        if name in seen and not results[path]:
            results[path] = "another file chosen has the same name"
        seen.setdefault(name, path)
    return results


def peer_from_json(d):
    """A device from `omdrop peers --json`: its address, and its name if known."""
    mac = d.get("mac") or d.get("address")
    if not mac:
        return None
    return {"address": mac, "name": d.get("name") or None, "rssi": d.get("rssi")}


def peer_label(peer):
    return peer.get("name") or f"Apple device ({peer['address'][-5:]})"


def send_status(line, who):
    """omdrop send's narration, in the popup's words (as Panel.qml words it)."""
    line = line.strip()
    m = re.match(r"^Preparing (.*)\.\.\.$", line)
    if m:
        return f"Preparing {m.group(1)}…"
    if re.match(r"^waiting up to \d+s for .* to start listening", line):
        return f"Waiting for {who} to wake…"
    if re.match(r"^sending .* to \S+ at ", line):
        return f"Waiting for {who} to accept…"
    if line.startswith("Omdrop is off. Turning it on"):
        return "Turning OmDrop on…"
    return None


def estimate_progress(sent, total):
    """awdl0 bytes out against the files' size; held at 99% until the send succeeds."""
    if total <= 0:
        return 0.0
    return max(0.0, min(0.99, sent / total))


def send_summary(sending):
    """(the popup's line about a finished send, whether anything failed)."""
    files = format_files(len(sending["paths"]))
    sent, failed = sending["sent"], sending["failed"]
    if not failed:
        return f"Sent {files} to {join_names(sent)}.", False
    if not sent and len(failed) == 1:
        who, why = failed[0]
        return ("Sending cancelled." if why == "cancelled"
                else why or f"Sending to {who} failed."), True
    parts = [f"Sent {files} to {join_names(sent)}."] if sent else []
    parts.append(f"Not sent to {join_names([w for w, _ in failed])}.")
    return " ".join(parts), True


def join_names(names):
    return names[0] if len(names) == 1 else ", ".join(names[:-1]) + " and " + names[-1]


class SendBackend:
    """Discovery reports {"address", "name"} dicts and (status, still_looking); send reports (0..1, text), then (ok, message)."""

    def start_discovery(self, on_peer, on_status):
        raise NotImplementedError

    def stop_discovery(self):
        raise NotImplementedError

    def send(self, peer, paths, on_progress, on_done):
        raise NotImplementedError

    def cancel_send(self):
        raise NotImplementedError

    def discovery_abandoned(self):
        pass

    def finish(self):
        pass


def read_lines(stream, on_line, on_end=None):
    """Call on_line for each line of a subprocess pipe, on the main loop."""
    data = Gio.DataInputStream.new(stream)

    def got(s, result):
        try:
            line, _ = s.read_line_finish_utf8(result)
        except GLib.Error:
            line = None
        if line is None:
            if on_end:
                on_end()
            return
        on_line(line)
        s.read_line_async(GLib.PRIORITY_DEFAULT, None, got)

    data.read_line_async(GLib.PRIORITY_DEFAULT, None, got)


class OmdropBackend(SendBackend):
    """Through the omdrop CLI: peers --json -n --stream (plain peers --json on older radios), send --to. Turns OmDrop on for discovery and back off after, if it was off."""

    def __init__(self, tray):
        self.tray = tray
        self.discovering = False
        self.peers_proc = None
        self.names = True
        self.turned_on = False
        self.send_proc = None
        self.progress_timer = None

    def spawn(self, args, merge=False):
        err = Gio.SubprocessFlags.STDERR_MERGE if merge else Gio.SubprocessFlags.STDERR_PIPE
        return Gio.Subprocess.new([self.tray.cli, *args], Gio.SubprocessFlags.STDOUT_PIPE | err)

    # -- discovery

    def start_discovery(self, on_peer, on_status):
        self.discovering = True
        self.on_peer, self.on_status = on_peer, on_status
        if not self.tray.cli:
            on_status("The omdrop command isn't installed.", False)
            return
        if self.tray.status.get("receiving"):
            self.run_peers()
            return
        on_status("Turning OmDrop on to look for devices…")

        def turned_on(rc, out):
            if not self.discovering:
                return
            if rc != 0:
                lines = [ln for ln in out.strip().splitlines() if ln.strip()]
                on_status(lines[-1] if lines else "OmDrop could not be turned on.", False)
                return
            self.turned_on = True
            self.tray.poll()
            self.run_peers()
        self.tray.cli_call(["on"], turned_on)

    def run_peers(self):
        if not self.discovering:
            return
        self.on_status("Looking for devices…")
        args = ["peers", "--json", "-n", "--stream"] if self.names else ["peers", "--json"]
        try:
            # One pipe for both, so an error line is read before the end is.
            proc = self.peers_proc = self.spawn(args, merge=True)
        except GLib.Error as e:
            self.on_status(e.message, False)
            return
        started = GLib.get_monotonic_time()
        errors = []

        def line(text):
            text = text.strip()
            if not text:
                return
            try:
                found = json.loads(text)
            except ValueError:
                errors.append(text)
                return
            for d in found if isinstance(found, list) else [found]:
                peer = peer_from_json(d) if isinstance(d, dict) else None
                if peer and self.discovering:
                    self.on_peer(peer)

        def ended():
            if proc is not self.peers_proc:
                return
            self.peers_proc = None
            if not self.discovering:
                return
            quick = GLib.get_monotonic_time() - started < 5_000_000
            if self.names and quick and any("newer" in e for e in errors):
                self.names = False          # an older radio package: no names
                GLib.idle_add(lambda: self.run_peers() and False)
                return
            # A lookup that ends at once would otherwise rerun in a tight loop.
            GLib.timeout_add(10_000 if quick else 250, lambda: self.run_peers() and False)

        read_lines(proc.get_stdout_pipe(), line, ended)

    def stop_discovery(self):
        self.discovering = False
        if self.peers_proc:
            self.peers_proc.send_signal(15)
            self.peers_proc = None

    def discovery_abandoned(self):
        """Nothing was sent: put OmDrop back the way it was."""
        self.turn_back_off()

    def finish(self):
        """The last send is over: put OmDrop back the way it was."""
        self.turn_back_off()

    def turn_back_off(self):
        if self.turned_on:
            self.turned_on = False
            self.tray.cli_call(["off"], lambda rc, out: self.tray.poll())

    # -- sending

    def send(self, peer, paths, on_progress, on_done):
        who = peer_label(peer)
        total = 0
        for p in paths:
            try:
                total += os.path.getsize(p)
            except OSError:
                pass
        try:
            proc = self.send_proc = self.spawn(["send", "--to", peer["address"], "--", *paths])
        except GLib.Error as e:
            on_done(False, e.message)
            return
        stats = os.path.join(AWDL, "statistics")
        # awdl0's transmit count from here on. If OmDrop comes on during the
        # send, awdl0 is new and counts from zero; what the old one sent carries.
        state = {"text": f"Sending to {who}…", "last": "", "sent": 0, "offset": 0,
                 "base": read_int(os.path.join(stats, "tx_bytes")) or 0,
                 "ifindex": read_int(os.path.join(AWDL, "ifindex"))}

        def narrate(line):
            if line.strip():
                state["last"] = line.strip()
            said = send_status(line, who)
            if said:
                state["text"] = said
                on_progress(estimate_progress(state["sent"], total), said)

        def sample():
            tx = read_int(os.path.join(stats, "tx_bytes"))
            ifindex = read_int(os.path.join(AWDL, "ifindex"))
            if tx is not None:
                if ifindex != state["ifindex"]:
                    state.update(offset=state["sent"], base=0, ifindex=ifindex)
                state["sent"] = max(state["sent"], state["offset"] + tx - state["base"])
            fraction = estimate_progress(state["sent"], total)
            if fraction > 0.02 and not state["text"].startswith("Sending "):
                state["text"] = f"Sending {format_files(len(paths))} to {who}"
            on_progress(fraction, state["text"])
            return True

        self.progress_timer = GLib.timeout_add(500, sample)
        read_lines(proc.get_stdout_pipe(), narrate)
        read_lines(proc.get_stderr_pipe(), narrate)

        def finished(p, result):
            try:
                p.wait_finish(result)
            except GLib.Error:
                pass
            if self.progress_timer:
                GLib.source_remove(self.progress_timer)
                self.progress_timer = None
            cancelled = self.send_proc is None
            self.send_proc = None
            ok = p.get_if_exited() and p.get_exit_status() == 0
            if ok:
                on_progress(1.0, f"Sent to {who}")
            if not cancelled:
                on_done(ok, "" if ok else (state["last"] or f"Sending to {who} failed."))

        proc.wait_async(None, finished)

    def cancel_send(self):
        proc, self.send_proc = self.send_proc, None
        if proc:
            proc.send_signal(15)


