def floor_units(value, units, step=1000):
    """value in the largest of units it reaches (the first at least), rounded down."""
    unit = units[0]
    for next_unit in units[1:]:
        if value < step:
            break
        value, unit = value / step, next_unit
    return f"{math.floor(value)} {unit}"


def format_rate(bits_per_second):
    return floor_units(bits_per_second / 1000, ("Kb/s", "Mb/s", "Gb/s", "Tb/s"))


def format_size(n_bytes):
    return floor_units(n_bytes / 1000, ("KB", "MB", "GB", "TB"))


def format_files(n):
    return f"{n} file" if n == 1 else f"{n} files"


def format_clock(seconds):
    seconds = max(0, int(seconds))
    h, rest = divmod(seconds, 3600)
    m, s = divmod(rest, 60)
    return f"{h}:{m:02d}:{s:02d}" if h else f"{m}:{s:02d}"


def files_in_log_line(line):
    """How many files a receiver log line says it stored (cmd_watch's rules)."""
    if "upload " in line and ": stored " in line:
        rest = line.split(": stored ", 1)[1]
        return len([f for f in rest.split(",") if f.strip()])
    if "link stored as " in line:
        return 1
    return 0


def read_int(path):
    try:
        with open(path) as f:
            return int(f.read())
    except (OSError, ValueError):
        return None


class Counters:
    """awdl0 bytes in and out, and files received and sent, kept until Reset. A new ifindex is a new awdl0, counting from zero."""

    def __init__(self):
        self.transferred = 0
        self.files = 0
        self.ifindex = None
        self.last_total = None      # awdl0's rx + tx when last counted
        self.prev_total = None      # and a second ago, for the rate
        self.rate = 0.0
        self.dirty = False
        self.load()

    def load(self):
        try:
            with open(STATE_FILE) as f:
                d = json.load(f)
            # "received" is what versions that counted only inbound saved.
            self.transferred = int(d.get("transferred", d.get("received", 0)))
            self.files = int(d.get("files", 0))
            self.ifindex = d.get("ifindex")
            last = d.get("last_total")
            self.last_total = int(last) if last is not None else None
        except (OSError, ValueError, TypeError):
            pass

    def save(self):
        if not self.dirty:
            return
        try:
            os.makedirs(os.path.dirname(STATE_FILE), exist_ok=True)
            tmp = STATE_FILE + ".tmp"
            with open(tmp, "w") as f:
                json.dump({"transferred": self.transferred, "files": self.files,
                           "ifindex": self.ifindex, "last_total": self.last_total}, f)
            os.replace(tmp, STATE_FILE)
            self.dirty = False
        except OSError:
            pass

    def reset(self):
        self.transferred = 0
        self.files = 0
        self.dirty = True
        self.save()

    def add_files(self, n):
        if n:
            self.files += n
            self.dirty = True

    def sample(self, seconds):
        stats = os.path.join(AWDL, "statistics")
        rx = read_int(os.path.join(stats, "rx_bytes"))
        tx = read_int(os.path.join(stats, "tx_bytes"))
        if rx is None or tx is None:
            self.prev_total, self.rate = None, 0.0
            return
        total = rx + tx
        ifindex = read_int(os.path.join(AWDL, "ifindex"))
        if ifindex != self.ifindex or (self.last_total is not None and total < self.last_total):
            # A new awdl0: all of its count is new.
            self.ifindex, self.last_total, self.prev_total = ifindex, 0, None
            self.dirty = True
        elif self.last_total is None:
            self.last_total = total     # an old count with no baseline: start here
        if total != self.last_total:
            self.transferred += total - self.last_total
            self.last_total = total
            self.dirty = True
        if self.prev_total is not None and total >= self.prev_total and seconds > 0:
            self.rate = (total - self.prev_total) * 8 / seconds
        else:
            self.rate = 0.0
        self.prev_total = total


