class PanelIcon:
    """Tray icon: XApp (Cinnamon, MATE, Xfce), else AppIndicator (KDE, GNOME, Budgie, waybar), else GTK (X11 trays)."""

    def __init__(self, on_click, on_size, menu):
        if XApp:
            icon = XApp.StatusIcon()
            icon.set_name("omdrop-tray")
            icon.connect("button-release-event", lambda _i, x, y, b, *_: b == 1 and on_click(x, y))
            icon.connect("notify::icon-size", lambda *_: on_size(icon.get_icon_size()))
            icon.set_secondary_menu(menu)
        elif AppIndicator:
            icon = AppIndicator.Indicator.new("omdrop-tray", "omdrop-off-symbolic",
                                              AppIndicator.IndicatorCategory.COMMUNICATIONS)
            icon.set_status(AppIndicator.IndicatorStatus.ACTIVE)
            item = Gtk.MenuItem(label="Open OmDrop")
            item.connect("activate", lambda *_: on_click(*pointer()))
            menu.prepend(item)
            menu.show_all()
            icon.set_menu(menu)
            icon.set_secondary_activate_target(item)
        else:
            with warnings.catch_warnings():
                warnings.simplefilter("ignore")
                icon = Gtk.StatusIcon()
            icon.connect("activate", lambda *_: on_click(*pointer()))
            icon.connect("popup-menu", lambda _i, b, t: menu.popup(None, None, None, None, b, t))
        self.icon = icon

    def set_icon_name(self, name):
        if XApp:
            self.icon.set_icon_name(name)
        elif AppIndicator:
            if os.path.isabs(name):
                self.icon.set_icon_theme_path(os.path.dirname(name))
                name = os.path.splitext(os.path.basename(name))[0]
            self.icon.set_icon_full(name, "OmDrop")
        elif os.path.isabs(name):
            self.icon.set_from_file(name)
        else:
            self.icon.set_from_icon_name(name)

    def set_label(self, text):
        if XApp:
            self.icon.set_label(text)
        elif AppIndicator:
            self.icon.set_label(text, "0:00:00")

    def set_tooltip_text(self, text):
        if AppIndicator and not XApp:
            self.icon.set_title(text)
        else:
            self.icon.set_tooltip_text(text)


