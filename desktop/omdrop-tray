class SpanPicker(Gtk.Box):
    """A row of buttons, one per duration: nothing pops up, so nothing moves."""

    def __init__(self):
        super().__init__(spacing=0, homogeneous=True)
        self.get_style_context().add_class("linked")
        self.get_style_context().add_class("omdrop-span")
        self.buttons, group = {}, None
        for label, tip, arg in DURATIONS:
            b = Gtk.RadioButton.new_with_label_from_widget(group, label)
            b.set_mode(False)            # a button, not a radio circle
            b.set_tooltip_text(tip)
            group = group or b
            self.pack_start(b, True, True, 0)
            self.buttons[arg] = b
        self.set_active_id(DEFAULT_DURATION)

    def get_active_id(self):
        return next(arg for arg, b in self.buttons.items() if b.get_active())

    def set_active_id(self, arg):
        if arg in self.buttons:
            self.buttons[arg].set_active(True)

