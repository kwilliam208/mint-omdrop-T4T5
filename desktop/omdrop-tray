def place_near(window, x, y):
    """Put window in the corner of the monitor's work area nearest (x, y)."""
    display = Gdk.Display.get_default()
    if x or y:
        monitor = display.get_monitor_at_point(x, y)
    else:
        # Opened without a click (launched again from the menu): Mint's
        # tray corner, bottom right of the primary monitor.
        monitor = display.get_primary_monitor() or display.get_monitor(0)
    area = monitor.get_workarea()
    size = window.get_preferred_size()[1]
    w, h = size.width, size.height
    margin = 4
    right = x >= area.x + area.width / 2 if (x or y) else True
    bottom = y >= area.y + area.height / 2 if (x or y) else True
    px = area.x + area.width - w - margin if right else area.x + margin
    py = area.y + area.height - h - margin if bottom else area.y + margin
    window.move(px, py)


class SendWindow(CardWindow):
    """Files, then devices. Discovery starts before the chooser opens."""

    WIDTH = 380

    def __init__(self, tray, paths):
        super().__init__(tray, "Send Files", self.WIDTH, Gdk.WindowTypeHint.DIALOG)
