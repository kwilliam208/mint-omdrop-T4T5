def paint(label, text, colour):
    label.set_text(text)
    ctx = label.get_style_context()
    for c in SetupStep.COLOURS.values():
        ctx.remove_class(c)
    if colour:
        ctx.add_class(colour)


def wrapped(text, dim=False):
    label = Gtk.Label(label=text, xalign=0, wrap=True)
    label.set_max_width_chars(1)
    if dim:
        label.get_style_context().add_class("omdrop-dim")
    return label


TRENCHCOAT = (
    "One question, in a trenchcoat. OmDrop and your Wi-Fi share one card. Some cards "
    "can do both at once (Shared). Others hand OmDrop the whole card while it's on "
    "(Single radio), so Wi-Fi drops until you turn OmDrop off. Underneath, it's a laptop "
    "or desktop question: plugged into Ethernet, lending OmDrop the card costs nothing; "
    "living on Wi-Fi, you'll notice.")


class ConfigWindow(CardWindow):
    """Install, then configure: one window that stays put. Before an install it walks
    the steps in order; after, any step can be revisited, and the corner holds the
    file locations and Uninstall."""

    WIDTH, PAGE_HEIGHT = 400, 300
    NAMES = ("Check", "Install", "Detect HW", "Mode")

    def __init__(self, tray):
        self.configuring = os.access(HELPER, os.X_OK)
        super().__init__(tray, "OmDrop Configurator" if self.configuring else "OmDrop Installer",
                         self.WIDTH, Gdk.WindowTypeHint.DIALOG)
        self.aside.get_style_context().add_class("omdrop-dim")
        self.tool = setup_tool()
        self.proc = None
        self.recommended = None
        self.detected = False
        self.failed = {}          # mode: why Detect HW couldn't bring it up here
        self.go = None
        self.page = 0
        self.check = SetupStep("1 · Compatibility", "Check again")
        self.install = SetupStep("2 · Install", "Install")
        self.detect = SetupStep("3 · Detect HW", "Run")
        self.choose = SetupStep("4 · Mode")
        self.steps = (self.check, self.install, self.detect, self.choose)

        # The circles, one a step: where you are, and in the configurator a way there.
        chips = Gtk.Box(spacing=4, homogeneous=True)
        self.chips = []
        for i, name in enumerate(self.NAMES):
            chip = Gtk.Button()
            chip.set_relief(Gtk.ReliefStyle.NONE)
            chip.get_style_context().add_class("omdrop-chip")
            box = Gtk.Box(spacing=4, halign=Gtk.Align.CENTER)
            dot = Gtk.Label(label="○")
            box.pack_start(dot, False, False, 0)
            box.pack_start(Gtk.Label(label=name), False, False, 0)
            chip.add(box)
            chip.connect("clicked", lambda _b, i=i: self.go_to(i))
            chips.pack_start(chip, True, True, 0)
            self.chips.append((chip, dot))
        self.card.pack_start(chips, False, False, 0)

        intros = (
            "Checks this computer can run OmDrop.",
            "Installs what OmDrop needs, and keeps a ledger of every change so "
            "Uninstall can put it all back. Asks for your password once.",
            "Tries each way this Wi-Fi card can run OmDrop, about 20 seconds each, "
            "and recommends the one that works best.",
            TRENCHCOAT,
        )
        self.pages = Gtk.Stack()
        self.pages.set_transition_type(Gtk.StackTransitionType.NONE)
        self.pages.set_size_request(-1, self.PAGE_HEIGHT)
        for i, (step, intro) in enumerate(zip(self.steps, intros)):
            page = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8)
            step.reorder_child(step.detail, 1)
            step.pack_start(wrapped(intro), False, False, 0)
            step.reorder_child(step.get_children()[-1], 1)
            page.pack_start(step, False, False, 0)
            self.pages.add_named(scrolled(page), str(i))
        self.ledger = wrapped("", dim=True)
        self.ledger.get_style_context().add_class("omdrop-small")
        self.install.pack_start(self.ledger, False, False, 4)
        self.mode_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=4)
        self.choose.pack_start(self.mode_box, False, False, 0)
        self.legacy = Gtk.CheckButton(label="Legacy (Troubleshooting)")
        self.legacy.set_tooltip_text("Sends at the old 12 Mbit/s. Try it if sends stall on this card.")
        self.legacy.set_active(os.path.exists(LEGACY_FLAG))
        self.legacy.connect("toggled", lambda b: self.tray.set_legacy(b.get_active()))
        self.choose.pack_start(self.legacy, False, False, 6)
        self.mode_buttons = {}

        undo, before = ledger_summary()
        gone = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8)
        gone.pack_start(wrapped("Removes Linux OmDrop Installer and puts back what it changed:"), False, False, 0)
        gone.pack_start(wrapped("\n".join("• " + u for u in undo) or "• Nothing recorded to undo"), False, False, 0)
        if before:
            gone.pack_start(wrapped("Before it was installed:\n" + "\n".join(before), dim=True), False, False, 0)
        gone.pack_start(wrapped("Received files and your OmDrop name are kept.", dim=True), False, False, 0)
        self.gone_note = wrapped("")
        gone.pack_start(self.gone_note, False, False, 0)
        self.pages.add_named(scrolled(gone), "uninstall")
        self.card.pack_start(self.pages, True, True, 0)

        # The corner: where things live, and the way out.
        self.corner = Gtk.Box(spacing=8)
        files = wrapped("Program   /usr/lib/omdrop\nSettings  /etc/omdrop\nLedger    /var/lib/omdrop-installer", dim=True)
        files.get_style_context().add_class("omdrop-small")
        self.corner.pack_start(files, True, True, 0)
        out = Gtk.Button(label="Uninstall…")
        out.set_relief(Gtk.ReliefStyle.NONE)
        out.get_style_context().add_class("omdrop-small")
        out.connect("clicked", lambda *_: self.go_to("uninstall"))
        self.corner.pack_end(out, False, False, 0)
        self.corner_slot = Gtk.Stack()
        self.corner_slot.set_transition_type(Gtk.StackTransitionType.CROSSFADE)
        self.corner_slot.set_transition_duration(400)
        self.corner_slot.add_named(Gtk.Box(), "empty")
        self.corner_slot.add_named(self.corner, "corner")
        self.card.pack_start(self.corner_slot, False, False, 0)

        buttons = Gtk.Box(spacing=6)
        self.back = Gtk.Button()
        self.back.connect("clicked", self.on_back)
        buttons.pack_start(self.back, False, False, 0)
        self.next = Gtk.Button()
        self.next.connect("clicked", self.on_next)
        buttons.pack_end(self.next, False, False, 0)
        self.card.pack_start(buttons, False, False, 2)

        for step, handler in ((self.check, self.run_check), (self.install, self.on_install),
                              (self.detect, self.on_detect)):
            step.button.connect("clicked", lambda *_, h=handler: h())
        self.connect("delete-event", lambda *_: self.close() or True)
        self.connect("key-press-event", lambda w, e: e.keyval == Gdk.KEY_Escape and self.close())
        self.card.show_all()
        self.corner_slot.set_visible_child_name("corner" if self.configuring else "empty")
        if self.configuring:
            self.install.set("ok", "Installed.")
            self.show_ledger()
            self.fill_modes()
        self.run_check()

    def show_ledger(self):
        lines = ledger_lines()
        self.ledger.set_text("Ledger, newest first:\n" + "\n".join(lines) if lines else "")
        self.ledger.set_visible(bool(lines))

    # -- state

    def installed(self):
        return os.access(HELPER, os.X_OK)

    def busy(self):
        return self.proc is not None

    def ready(self, page):
        return (bool(self.go), self.installed(), self.detected or bool(self.mode_buttons),
                self.chosen() is not None)[page]

    def update(self):
        busy = self.busy()
        done = self.installed()
        self.check.button.set_sensitive(not busy)
        self.install.button.set_label("Reinstall" if done else "Install")
        self.install.button.set_sensitive(bool(self.go) and not busy and self.tool is not None)
        self.detect.button.set_sensitive(done and not busy)
        for i, (chip, dot) in enumerate(self.chips):
            step = self.steps[i]
            paint(dot, SetupStep.MARKS[step.state], SetupStep.COLOURS.get(step.state))
            here = self.page if isinstance(self.page, int) else len(self.steps)
            reachable = self.configuring or i <= here or all(self.ready(j) for j in range(i))
            chip.set_sensitive(reachable and not busy)
            ctx = chip.get_style_context()
            (ctx.add_class if i == self.page else ctx.remove_class)("omdrop-chip-here")
        leaving = self.page == "uninstall"
        if leaving:
            self.back.set_label("Back")
            self.next.set_label("Uninstall")
            on = not busy and self.tool is not None
            self.aside.set_text("")
        elif self.configuring:
            self.back.set_label("Close")
            self.next.set_label("Save" if self.page == 3 else "Next")
            on = (self.page < 3 or self.chosen() is not None) and not busy
            self.aside.set_text("")
        else:
            self.back.set_label("Cancel" if self.page == 0 else "Back")
            self.next.set_label("Finish" if self.page == 3 else "Next")
            on = self.ready(self.page) and not busy
            self.aside.set_text(f"step {self.page + 1} of 4")
        self.back.set_sensitive(not busy)
        self.next.set_sensitive(on)
        # Colour only when it can be pressed: grey and still, then green (or red) and ready.
        ctx = self.next.get_style_context()
        for c in ("suggested-action", "destructive-action"):
            ctx.remove_class(c)
        if on:
            ctx.add_class("destructive-action" if leaving else "suggested-action")
        self.pages.set_visible_child_name(str(self.page))

    def go_to(self, page):
        self.page = page
        self.update()

    def on_back(self, _button):
        if self.page == "uninstall":
            self.go_to(0)
        elif self.page == 0 or self.configuring:
            self.close()
        else:
            self.go_to(self.page - 1)

    def on_next(self, _button):
        if self.page == "uninstall":
            self.uninstall()
        elif self.page == 3:
            self.save_mode()
        else:
            self.go_to(self.page + 1)

    def run(self, args, step, on_line, on_done, env=None):
        step.set("busy")
        self.proc = run_streaming([self.tool, *args], on_line,
                                  lambda rc: (setattr(self, "proc", None), on_done(rc), self.update()), env)
        self.update()

    # -- the steps

    def run_check(self):
        if not self.tool:
            self.check.set("fail", "omdrop-installer wasn't found; run install.sh again.")
            return
        out = []

        def done(rc):
            try:
                result = json.loads(out[-1])
            except (ValueError, IndexError):
                self.check.set("fail", "The check didn't run.")
                return
            notes = [c["text"] for c in result["checks"] if c["level"] != "GO"]
            self.go = result["verdict"] != "NOGO"
            state = {"GO": "ok", "WARN": "warn", "NOGO": "fail"}[result["verdict"]]
            verdict = {"GO": "GO", "WARN": "GO, with warnings", "NOGO": "NO-GO"}[result["verdict"]]
            self.check.set(state, "\n".join([verdict] + notes))
        self.run(["check", "--json"], self.check, out.append, done)

    def on_install(self):
        def done(rc):
            if rc == 0:
                self.install.set("ok", "Installed. Uninstall… is in the corner below.")
                self.show_ledger()
                self.corner_slot.set_visible_child_name("corner")
                self.fill_modes()
            else:
                self.install.set("fail", self.install.detail.get_text() or "The install failed.")
        self.run(["install"], self.install, lambda line: line.strip() and self.install.set("busy", line.strip()), done)

    def on_detect(self):
        out = []

        def line(text):
            if text.startswith("{"):
                out.append(text)
            elif text.strip():
                self.detect.set("busy", text.strip() + " Wi-Fi may drop meanwhile.")

        def done(rc):
            self.detected = True
            try:
                result = json.loads(out[-1])
            except (ValueError, IndexError):
                self.detect.set("fail", "Detection didn't finish.")
                return
            self.recommended = result.get("recommended") or None
            self.failed = {t["mode"]: short_reason(t) for t in result.get("results", [])
                           if not (t.get("started") and t.get("awdl"))}
            lines = [trial_line(t, t["mode"] == self.recommended) for t in result.get("results", [])]
            self.detect.set("ok" if self.recommended else "fail", "\n".join(lines) or "No mode brought OmDrop up.")
            self.fill_modes()
        self.run(["detect", "--json"], self.detect, line, done)

    def fill_modes(self):
        try:
            caps = json.loads(subprocess_output([HELPER, "caps"]))
        except ValueError:
            caps = {}
        available = ["shared"] if caps.get("monitor") else []
        available += ["exclusive"] if caps.get("ibss") else []
        available += ["active-monitor"] if caps.get("active_monitor") else []
        current = caps.get("profile") if caps.get("tested") else None
        for child in self.mode_box.get_children():
            self.mode_box.remove(child)
        self.mode_buttons, group = {}, None
        for mode in sorted(available, key=lambda m: m != self.recommended):
            name, cost = MODES[mode]
            tag = " · recommended" if mode == self.recommended else (" · current" if mode == current else "")
            if mode in self.failed:
                tag = f" · didn't start here ({self.failed[mode]})"
            radio = Gtk.RadioButton.new_with_label_from_widget(group, f"{name}: {cost}{tag}")
            radio.get_child().set_line_wrap(True)
            radio.connect("toggled", lambda *_: self.update())
            group = group or radio
            self.mode_box.pack_start(radio, False, False, 0)
            self.mode_buttons[mode] = radio
        usable = [m for m in available if m not in self.failed]
        pick = self.recommended or (current if current in usable else None) or (usable[0] if usable else None)
        if pick:
            self.mode_buttons[pick].set_active(True)
        if current and self.choose.state == "todo":
            self.choose.set("ok", "")
        self.mode_box.show_all()
        self.update()

    def chosen(self):
        return next((m for m, b in self.mode_buttons.items() if b.get_active()), None)

    def save_mode(self):
        mode = self.chosen()

        def done(rc):
            if rc != 0:
                self.choose.set("fail", "Couldn't save the mode.")
                return
            self.choose.set("ok", "Saved: %s. It applies the next time OmDrop turns on." % MODES[mode][0])
            self.fill_modes()
            self.tray.setup_done()
            if not self.configuring:
                self.destroy()
        self.run(["configure", mode], self.choose, lambda line: None, done)

    def uninstall(self):
        def done(rc):
            if rc == 0:
                self.gone_note.set_text("Uninstalled. What was there before is back.")
                GLib.timeout_add(2500, lambda: self.tray.quit() and False)
            else:
                self.gone_note.set_text("Uninstall didn't finish.")
        self.gone_note.set_text("Uninstalling…")
        self.run(["uninstall"], self.choose, lambda line: line.strip() and self.gone_note.set_text(line.strip()),
                 done, {"OMDROP_FROM_TRAY": "1"})

    def close(self):
        if not self.proc:
            self.destroy()
        return True


def short_reason(trial):
    """Why a trial failed, in a few words."""
    reason = (trial.get("reason") or "").split(",")[0].split(" (")[0].strip().rstrip(".")
    return reason or ("OmDrop didn't come up" if trial.get("started") else "it couldn't start")


def scrolled(child):
    """child in a fixed-height page: long content scrolls instead of growing the window."""
    box = Gtk.ScrolledWindow()
    box.set_policy(Gtk.PolicyType.NEVER, Gtk.PolicyType.AUTOMATIC)
    box.add(child)
    return box


LEDGER_WORDS = {"new": "added", "saved": "replaced, original kept:", "pkg": "installed package",
                "gone": "removed package", "omdrop-cli": "set up the omdrop command in"}


def ledger_lines(paths=None):
    """Every ledger entry in words, the most recent write first."""
    out = []
    home = os.path.expanduser("~")
    for path in reversed(paths or LEDGERS):      # yours is written after the system's
        try:
            lines = open(path).read().splitlines()
        except OSError:
            continue
        for line in reversed(lines):
            if not line or line.startswith("#"):
                continue
            what, _, arg = line.partition(" ")
            arg = arg.replace(home, "~", 1) if arg.startswith(home) else arg
            if what in ("ufw", "firewalld"):
                out.append(f"opened TCP 8771 on awdl0 ({'UFW' if what == 'ufw' else 'firewalld'})")
            else:
                out.append(f"{LEDGER_WORDS.get(what, what)} {arg}".strip())
    return out


LEDGERS = ("/var/lib/omdrop-installer/ledger",
           os.path.join(os.environ.get("XDG_STATE_HOME") or os.path.expanduser("~/.local/state"),
                        "omdrop-installer", "ledger"))


def plural(n, one, many):
    return f"{n} {one if n == 1 else many}"


def ledger_summary(paths=LEDGERS):
    """What uninstall will undo, in a few lines, from the install ledgers."""
    seen = {"new": 0, "saved": 0, "pkg": 0, "rule": 0, "cli": 0, "gone": 0}
    before = []
    for path in paths:
        try:
            lines = open(path).read().splitlines()
        except OSError:
            continue
        for line in lines:
            what = line.split(" ", 1)[0]
            if line.startswith("# before: "):
                if line[len("# before: "):] not in before:
                    before.append(line[len("# before: "):])
            elif what in ("new", "saved", "pkg", "gone"):
                seen[what] += 1
            elif what in ("ufw", "firewalld"):
                seen["rule"] += 1
            elif what == "omdrop-cli":
                seen["cli"] += 1
    out = []
    if seen["new"]:
        out.append(f"Removes {plural(seen['new'], 'file and folder', 'files and folders')} it added")
    if seen["saved"]:
        out.append(f"Puts back {seen['saved']} it replaced")
    if seen["pkg"]:
        out.append(f"Removes {plural(seen['pkg'], 'package', 'packages')} it installed, unless something else needs "
                   f"{'it' if seen['pkg'] == 1 else 'them'}")
    if seen["rule"]:
        out.append("Removes its firewall rule")
    if seen["cli"]:
        out.append("Removes the omdrop command it set up")
    if seen["gone"]:
        out.append("Can't bring back the omdrop-owl package it replaced")
    return out, before


def subprocess_output(args):
    try:
        ok, out, _err, _rc = GLib.spawn_sync(None, args, None, GLib.SpawnFlags.SEARCH_PATH, None)
        return out.decode() if ok else ""
    except GLib.Error:
        return ""


def trial_line(t, recommended):
    """One Detect HW result, in words."""
    name = MODES.get(t.get("mode"), (t.get("mode"),))[0]
    if not t.get("started"):
        return f"✗ {name}: didn't start ({t.get('reason') or 'unknown'})"
    gateway = {True: "router answered", False: "router didn't answer", None: "no router"}[t.get("gateway")]
    mark = "★" if recommended else ("✓" if t.get("awdl") else "✗")
    return f"{mark} {name}: OmDrop {'up' if t.get('awdl') else 'down'}, {t.get('peers', 0)} device(s), {gateway}"


class Tray(Gtk.Application):
    def __init__(self):
        super().__init__(application_id=APP_ID, flags=Gio.ApplicationFlags.FLAGS_NONE)
        self.cli = None
        self.status = {}
        self.state = "off"        # off, loading, on
        self.busy = None          # "on" or "off" while that command runs
        self.error = ""
        self.remaining = None     # seconds, counted down locally between polls
        self.settle = 0
        self.counters = Counters()
        self.icon = None
        self.icon_props = {}
        self.popup = None
        self.layout = None        # what the popup last showed, to refit it on a change
        self.dots = 0
        self.last_x = self.last_y = 0
        self.journal = None
        self.backend = BACKEND(self)
        self.discovering = False
        self.found = []             # devices that answered before the window opened
        self.send_window = None
        self.chooser = None
        self.sending = None         # {"peer", "paths", "progress"} while a send runs
        self.send_result = ""
        self.send_failed = False
        self.discovery_note = None  # discovery's last (text, still looking)
        self.symbolic_size = None   # what the panel draws symbolic icons at
        self.fullcolor_size = None  # and full-colour ones
        self.ring_dir = os.path.join(GLib.get_user_runtime_dir(), "omdrop-tray")
        self.setup_window = None
        self.setup_pending = SETUP or not os.access(HELPER, os.X_OK)
        self.ring_fg = None

    def do_activate(self):
        if self.icon is not None:
            self.open_setup() if self.setup_pending else self.show_popup()
            return
        self.hold()
        provider = Gtk.CssProvider()
        provider.load_from_data(CSS)
        Gtk.StyleContext.add_provider_for_screen(
            Gdk.Screen.get_default(), provider, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)

        self.cli = find_cli()
        self.popup = Popup(self)
        menu = Gtk.Menu()
        configure = Gtk.MenuItem(label="Configure…")
        configure.connect("activate", lambda *_: self.open_setup())
        menu.append(configure)
        menu.append(Gtk.SeparatorMenuItem())
        quit_item = Gtk.MenuItem(label="Quit OmDrop status")
        quit_item.connect("activate", lambda *_: self.quit())
        menu.append(quit_item)
        menu.show_all()
        self.icon = PanelIcon(self.on_icon_click, self.on_icon_size, menu)

        # Actions on the session bus, for scripts and keyboard shortcuts:
        # org.gtk.Actions.Activate("turn-on", ["20m"], {}), "turn-off", "quit".
        on = Gio.SimpleAction.new("turn-on", GLib.VariantType.new("s"))
        on.connect("activate", lambda _a, span: self.turn_on(span.get_string()))
        self.add_action(on)
        off = Gio.SimpleAction.new("turn-off", None)
        off.connect("activate", lambda *_: self.turn_off())
        self.add_action(off)
        setup_action = Gio.SimpleAction.new("setup", None)
        setup_action.connect("activate", lambda *_: self.open_setup())
        self.add_action(setup_action)
        quit_action = Gio.SimpleAction.new("quit", None)
        quit_action.connect("activate", lambda *_: self.quit())
        self.add_action(quit_action)

        self.follow_journal()
        GLib.timeout_add_seconds(1, self.tick)
        GLib.timeout_add_seconds(POLL_SECONDS, self.poll)
        self.poll()
        self.render()

    def do_shutdown(self):
        self.counters.save()
        if self.sending:
            self.backend.cancel_send()
        self.clear_rings()
        Gtk.Application.do_shutdown(self)

    # ------------------------------------------------------------ the CLI

    def cli_call(self, args, done):
        if not self.cli:
            self.cli = find_cli()
        if not self.cli:
            self.error = "The omdrop command isn't installed. Run: omdrop-installer install"
            self.render()
            return
        proc = Gio.Subprocess.new([self.cli, *args],
                                  Gio.SubprocessFlags.STDOUT_PIPE | Gio.SubprocessFlags.STDERR_MERGE)

        def finished(p, result):
            try:
                _, out, _ = p.communicate_utf8_finish(result)
            except GLib.Error as e:
                out = str(e)
            done(p.get_exit_status() if p.get_if_exited() else 1, out or "")

        proc.communicate_utf8_async(None, None, finished)

    def poll(self):
        def done(rc, out):
            try:
                self.status = json.loads(out)
            except ValueError:
                self.status = {}
            self.update_state()
        self.cli_call(["status", "--json"], done)
        return True

    def turn_on(self, span):
        if span not in [arg for _label, _tip, arg in DURATIONS]:
            self.error = f"Not a duration this panel offers: {span}"
            self.render()
            return
        self.popup.duration.set_active_id(span)
        self.busy, self.error = "on", ""
        self.render()

        def done(rc, out):
            self.busy = None
            if rc != 0:
                lines = [ln for ln in out.strip().splitlines() if ln.strip()]
                self.error = lines[-1] if lines else "omdrop on failed"
            self.poll()
        # The chosen duration, passed as `omdrop on`'s window argument.
        self.cli_call(["on", span], done)

    def turn_off(self):
        self.busy, self.error = "off", ""
        self.render()

        def done(rc, out):
            self.busy = None
            if rc != 0:
                lines = [ln for ln in out.strip().splitlines() if ln.strip()]
                self.error = lines[-1] if lines else "omdrop off failed"
            self.poll()
        self.cli_call(["off"], done)

    def set_legacy(self, on):
        try:
            if on:
                os.makedirs(os.path.dirname(LEGACY_FLAG), exist_ok=True)
                open(LEGACY_FLAG, "a").close()
            elif os.path.exists(LEGACY_FLAG):
                os.remove(LEGACY_FLAG)
        except OSError as e:
            self.error = f"Couldn't change the send rate: {e.strerror}"
        if self.status.get("receiving"):
            self.send_result = "The new rate applies the next time OmDrop turns on."
            self.send_failed = False
        self.render()

    def reset_counters(self):
        self.counters.reset()
        self.render()

    def download_dir(self):
        return self.status.get("dir") or GLib.get_user_special_dir(
            GLib.UserDirectory.DIRECTORY_DOWNLOAD) or os.path.expanduser("~/Downloads")

    def open_folder(self):
        path = self.download_dir()
        try:
            Gio.AppInfo.launch_default_for_uri(Gio.File.new_for_path(path).get_uri(), None)
            self.popup.hide()
        except GLib.Error as e:
            self.error = f"Couldn't open {path}: {e.message}"
            self.render()

    # ------------------------------------------------------------ sending

    def send_files(self):
        """Send Files: start finding devices, then ask for the files."""
        if self.sending or self.chooser or self.send_window:
            if self.send_window:
                self.send_window.present()
            return
        self.popup.hide()
        self.send_result = ""
        self.found = []
        self.discovering = True
        self.backend.start_discovery(self.on_peer, self.on_discovery_status)
        self.chooser = Gtk.FileChooserNative.new(
            "Choose files to send", None, Gtk.FileChooserAction.OPEN, "_Choose", "_Cancel")
        self.chooser.set_select_multiple(True)
        self.chooser.set_local_only(True)
        self.chooser.connect("response", self.on_chosen)
        self.chooser.show()

    def on_chosen(self, chooser, response):
        paths = [f.get_path() for f in chooser.get_files()] if response == Gtk.ResponseType.ACCEPT else []
        self.chooser = None
        paths = [p for p in paths if p]
        if not paths:
            self.end_discovery(abandoned=True)
            return
        self.send_window = SendWindow(self, paths)
        self.send_window.connect("destroy", lambda *_: setattr(self, "send_window", None))
        for peer in self.found:
            self.send_window.add_peer(peer)
        if self.discovery_note:
            self.send_window.set_search_status(*self.discovery_note)
        self.send_window.show()
        self.send_window.refit()
        self.send_window.present()

    def on_peer(self, peer):
        if not self.discovering:
            return
        self.found.append(peer)
        if self.send_window:
            self.send_window.add_peer(peer)

    def on_discovery_status(self, text, busy=True):
        self.discovery_note = (text, busy)
        if self.send_window:
            self.send_window.set_search_status(text, busy)

    def end_discovery(self, abandoned=False):
        if self.discovering:
            self.discovering = False
            self.backend.stop_discovery()
            if abandoned:
                self.backend.discovery_abandoned()
        self.found = []
        self.discovery_note = None

    def start_send(self, peers, paths):
        """Send paths to each of peers in turn, OmDrop staying on between."""
        self.end_discovery()
        self.clear_rings()
        self.sending = {"peers": list(peers), "index": -1, "paths": paths,
                        "progress": 0.0, "text": "", "sent": [], "failed": []}
        self.send_next()

    def send_next(self):
        sending = self.sending
        sending["index"] += 1
        if sending["index"] >= len(sending["peers"]):
            self.sending = None
            self.send_result, self.send_failed = send_summary(sending)
            self.backend.finish()
            self.clear_rings()
            self.render()
            return
        sending["peer"] = sending["peers"][sending["index"]]
        sending["text"] = ""
        self.on_send_progress(0.0)
        self.backend.send(sending["peer"], sending["paths"], self.on_send_progress, self.on_send_done)

    def on_send_progress(self, fraction, text=""):
        sending = self.sending
        if sending:
            # The ring covers every recipient: each is an equal share of it.
            n = len(sending["peers"])
            fraction = max(0.0, min(1.0, fraction))
            sending["progress"] = (sending["index"] + fraction) / n
            sending["text"] = text or sending["text"]
            self.render()

    def on_send_done(self, ok, message=""):
        sending = self.sending
        if not sending:
            return
        who = peer_label(sending["peer"])
        if ok:
            sending["sent"].append(who)
            self.counters.add_files(len(sending["paths"]))
        else:
            sending["failed"].append((who, message))
        self.send_next()

    def cancel_send(self):
        sending = self.sending
        if sending:
            self.backend.cancel_send()
            sending["failed"].append((peer_label(sending["peer"]), "cancelled"))
            sending["index"] = len(sending["peers"]) - 1    # skip the rest
            self.send_next()

    def open_setup(self):
        """The configurator takes the panel's place, and stays where it opened."""
        self.popup.hide()
        if self.setup_window is None:
            self.setup_window = ConfigWindow(self)
            self.setup_window.connect("destroy", lambda *_: setattr(self, "setup_window", None))
            self.setup_window.show()
            self.setup_window.refit()
        self.setup_window.present()

    def setup_done(self):
        self.setup_pending = False
        self.cli = find_cli()
        self.poll()
        self.render()

    def place_window(self, window):
        place_near(window, self.last_x, self.last_y)

    # -- the ring

    def on_icon_size(self, size):
        if not size:
            return
        if str(self.icon_props.get("icon_name", "")).endswith("-symbolic"):
            self.symbolic_size = size
        elif self.sending:
            if size != self.fullcolor_size:
                self.fullcolor_size = size
                self.render()

    def ring_icon(self, progress):
        """The ring's SVG for this progress, written once per whole percent."""
        if self.ring_fg is None:
            self.ring_fg = panel_icon_colour()
        canvas = self.fullcolor_size or 32
        symbolic = min(self.symbolic_size or 16, canvas * 0.7)
        pct = int(progress * 100)
        path = os.path.join(self.ring_dir, f"ring-{canvas}-{int(symbolic)}-{pct:03d}.svg")
        if not os.path.exists(path):
            os.makedirs(self.ring_dir, exist_ok=True)
            with open(path, "w") as f:
                f.write(ring_svg(pct / 100, canvas, symbolic, self.ring_fg))
        return path

    def clear_rings(self):
        try:
            for name in os.listdir(self.ring_dir):
                if name.startswith("ring-") and name.endswith(".svg"):
                    os.remove(os.path.join(self.ring_dir, name))
        except OSError:
            pass

    # ------------------------------------------------------------ files

    def follow_journal(self):
        """Count files as the receiver logs storing them, from now on."""
        if not shutil.which("journalctl"):
            return
        try:
            self.journal = Gio.Subprocess.new(
                ["journalctl", "--user", "-u", RECEIVER_UNIT, "-f", "-n", "0", "-o", "cat"],
                Gio.SubprocessFlags.STDOUT_PIPE | Gio.SubprocessFlags.STDERR_SILENCE)
        except GLib.Error:
            return
        stream = Gio.DataInputStream.new(self.journal.get_stdout_pipe())

        def got_line(s, result):
            try:
                line, _ = s.read_line_finish_utf8(result)
            except GLib.Error:
                line = None
            if line is None:
                # journalctl ended; follow again shortly.
                GLib.timeout_add_seconds(10, lambda: self.follow_journal() and False)
                return
            n = files_in_log_line(line)
            if n:
                self.counters.add_files(n)
                self.counters.save()
                self.render()
            s.read_line_async(GLib.PRIORITY_DEFAULT, None, got_line)

        stream.read_line_async(GLib.PRIORITY_DEFAULT, None, got_line)

    # ------------------------------------------------------------ state

    def update_state(self):
        s = self.status
        receiving = bool(s.get("receiving"))
        visible = s.get("visible")
        rem = s.get("remaining")
        self.remaining = rem if isinstance(rem, int) else None

        if self.busy:
            self.state = "loading"
        elif not receiving:
            self.state = "off"
        elif visible is True:
            self.state = "on"
        elif self.settle < SETTLE_LIMIT:
            self.state = "loading"   # the radio is still coming up
        else:
            self.state = "on"        # up, but unseen: the detail line says so
        self.render()

    def tick(self):
        if self.status.get("receiving") and self.status.get("visible") is not True:
            self.settle += 1
        else:
            self.settle = 0
        if self.remaining is not None and self.remaining > 0:
            self.remaining -= 1
            if self.remaining == 0:
                self.poll()   # the timer is turning it off right now
        self.counters.sample(1)
        if self.dots == 0:
            self.counters.save()   # every third second at most
        self.dots = (self.dots + 1) % 3
        self.render()
        return True

    # ------------------------------------------------------------ drawing

    def view(self):
        """off, loading or on, with a running command counting as loading."""
        if self.busy:
            return "loading"
        return self.state

    def detail_text(self, view):
        if self.error:
            return self.error
        if not self.cli:
            return "The omdrop command isn't installed. Run: omdrop-installer install"
        s = self.status
        if not s:
            return ""
        name = s.get("name") or "this computer"
        if self.busy == "off":
            return "Turning OmDrop off."
        if view == "off":
            return f'Nearby Apple devices can\'t see "{name}".'
        if view == "loading":
            return "Waking the radio. This takes 10 to 60 seconds."
        if s.get("visible") is True:
            return f'Visible to nearby Apple devices as "{name}".'
        reason = s.get("reason")
        return "The receiver is up, but nothing is advertising on the radio" + \
            (f" ({reason})." if reason else ".")

    def render(self):
        view = self.view()
        dots = "." * (self.dots + 1)
        names = {"on": "On", "off": "Off", "loading": "Loading" + dots}
        mode = self.status.get("mode")
        timed = self.remaining is not None and view != "off"
        clock = format_clock(self.remaining) if timed else ""
        rate = format_rate(self.counters.rate)
        received = f"{format_size(self.counters.transferred)}, {format_files(self.counters.files)}"

        # The countdown sits beside the icon in the panel while a window runs.
        # Only changes go to the panel: each call is a D-Bus message.
        sending = self.sending
        if sending:
            who = peer_label(sending["peer"])
            pct = int(sending["progress"] * 100)
            text = sending["text"] or f"Sending {format_files(len(sending['paths']))} to {who}"
            # A percentage once bytes are moving; before that, what it waits for.
            send_text = f"{text}: {pct}%" if text.startswith("Sending ") else text
            n = len(sending["peers"])
            if n > 1:
                send_text = f"{sending['index'] + 1} of {n} · {send_text}"
            self.icon_set("icon_name", self.ring_icon(sending["progress"]))
            self.icon_set("label", "")
        else:
            self.icon_set("icon_name", panel_icon(view))
            self.icon_set("label", clock if view == "on" and timed else "")
        tip = f"OmDrop: {names[view].rstrip('.')}"
        if view == "on":
            tip += f" · {clock} left" if timed else " · indefinitely"
            tip += f"\nActivity: {rate}"
        tip += f"\nData transferred: {received}"
        if self.setup_pending:
            tip = "OmDrop: click to set up"
        if sending:
            tip = send_text + "\n" + tip
        self.icon_set("tooltip_text", tip)

        p = self.popup
        icon = icon_path(view)
        p.head_icon.set_from_gicon(Gio.FileIcon.new(Gio.File.new_for_path(icon))
                                   if os.path.isabs(icon) else Gio.ThemedIcon.new(icon),
                                   Gtk.IconSize.DND)
        p.state_label.set_text(names[view])
        ctx = p.state_label.get_style_context()
        for s in ("on", "off", "loading"):
            ctx.remove_class(f"omdrop-state-{s}")
        ctx.add_class(f"omdrop-state-{view}")

        if view == "off":
            p.stack.set_visible_child_name("off")
            p.toggle.set_label("Turn On")
            p.toggle.get_style_context().add_class("suggested-action")
            p.toggle.set_sensitive(self.cli is not None)
        else:
            p.stack.set_visible_child_name("on")
            p.toggle.get_style_context().remove_class("suggested-action")
            p.toggle.set_label("Turning off…" if self.busy == "off" else "Turn Off")
            p.toggle.set_sensitive(self.busy is None)
            if view == "loading" and not self.status.get("receiving"):
                p.clock_title.set_text("Loading" + dots)
                p.clock.set_text("")
                p.window_label.set_text("Starting OmDrop")
            else:
                p.clock_title.set_text("Time left")
                if timed:
                    p.clock.set_text(clock)
                    p.window_label.set_text("")
                elif mode == "once":
                    p.clock.set_text("—")
                    p.window_label.set_text("Until one file arrives")
                else:
                    p.clock.set_text("∞")
                    p.window_label.set_text("Until you turn it off")
            p.window_label.set_visible(bool(p.window_label.get_text()))
            p.activity.set_text(rate)
        p.received.set_text(received)
        p.reset.set_sensitive(bool(self.counters.transferred or self.counters.files))
        p.folder.set_tooltip_text(f"Open the OmDrop downloads folder ({self.download_dir()})")

        p.send_button.set_visible(not sending)
        p.send_button.set_sensitive(self.cli is not None and not self.send_window)
        p.sending_box.set_visible(bool(sending))
        if sending:
            p.sending_label.set_text(send_text)
            p.sending_bar.set_fraction(sending["progress"])

        detail = self.detail_text(view)
        if self.send_result and not self.error:
            detail = self.send_result
        p.detail.set_text(detail)
        p.detail.set_visible(bool(detail))
        dctx = p.detail.get_style_context()
        failed = self.error or (self.send_result and self.send_failed and detail == self.send_result)
        (dctx.add_class if failed else dctx.remove_class)("omdrop-error")

        # Refit and re-anchor only when the popup's shape can change, not on
        # every tick.
        layout = (view, p.window_label.get_visible(), detail, bool(sending))
        if p.get_visible() and layout != self.layout:
            p.resize(1, 1)
            p.place(self.last_x, self.last_y)
        self.layout = layout

    # ------------------------------------------------------------ the icon

    def icon_set(self, prop, value):
        if self.icon_props.get(prop) != value:
            self.icon_props[prop] = value
            getattr(self.icon, "set_" + prop)(value)

    def on_icon_click(self, x, y):
        self.last_x, self.last_y = x, y
        if self.setup_pending:
            self.open_setup()
        elif self.popup.get_visible():
            self.popup.hide()
        else:
            self.show_popup()

    def show_popup(self):
        self.poll()
        self.layout = None
        self.render()
        self.popup.show()
        self.popup.resize(1, 1)
        self.popup.place(self.last_x, self.last_y)
        self.popup.present()


def self_test():
    assert format_rate(0) == "0 Kb/s"
    assert format_rate(999_999) == "999 Kb/s"          # rounded down, never up
    assert format_rate(2_900_000) == "2 Mb/s"
    assert format_rate(3e9) == "3 Gb/s"
    assert format_rate(4.2e12) == "4 Tb/s"
    assert format_size(999) == "0 KB"
    assert format_size(44_548_140) == "44 MB"
    assert format_size(1_999_999_999) == "1 GB"
    assert format_files(1) == "1 file" and format_files(3) == "3 files"
    assert format_clock(65) == "1:05" and format_clock(3725) == "1:02:05"
    assert files_in_log_line("INFO root: upload 1A2B: stored IMG_5888.PNG") == 1
    assert files_in_log_line("INFO root: upload 1A2B: stored a.jpg, b.jpg,c.mov") == 3
    assert files_in_log_line("INFO root: link stored as x.url -> https://e.org") == 1
    assert files_in_log_line("INFO root: upload 1A2B: 30% of free bytes") == 0

    # Counters across a recreated awdl0, against a stand-in sysfs dir.
    import tempfile
    global AWDL, STATE_FILE
    AWDL = tempfile.mkdtemp()
    STATE_FILE = os.path.join(tempfile.mkdtemp(), "counters.json")
    os.makedirs(os.path.join(AWDL, "statistics"))

    def awdl(ifindex, rx, tx):
        for name, v in (("ifindex", ifindex), ("statistics/rx_bytes", rx),
                        ("statistics/tx_bytes", tx)):
            with open(os.path.join(AWDL, name), "w") as f:
                f.write(str(v))
    c = Counters()
    awdl(7, 1000, 500); c.sample(1)
    assert c.transferred == 1500
    awdl(7, 126000, 1500); c.sample(1)
    assert c.transferred == 127500 and c.rate == (125000 + 1000) * 8
    c.save()
    c2 = Counters()                            # a restart mid-session: no double count
    awdl(7, 127000, 2500); c2.sample(1)
    assert c2.transferred == 129500
    awdl(9, 400, 100); c2.sample(1)            # a new awdl0, counting from zero
    assert c2.transferred == 130000 and c2.rate == 0
    c2.add_files(2)
    c2.reset()
    assert (c2.transferred, c2.files) == (0, 0) and Counters().transferred == 0
    with open(STATE_FILE, "w") as f:           # an inbound-only count carries over
        json.dump({"received": 5000, "files": 3, "ifindex": 9, "last_rx": 400}, f)
    c3 = Counters()
    awdl(9, 600, 300); c3.sample(1)
    assert (c3.transferred, c3.files) == (5000, 3)
    awdl(9, 700, 400); c3.sample(1)
    assert c3.transferred == 5200
    shutil.rmtree(AWDL)

    # What Send Files accepts.
    d = tempfile.mkdtemp()
    ok = os.path.join(d, "photo.jpg")
    with open(ok, "wb") as f:
        f.write(b"x")
    os.symlink(ok, os.path.join(d, "link.jpg"))
    os.symlink(os.path.join(d, "gone"), os.path.join(d, "broken.jpg"))
    locked = os.path.join(d, "locked.jpg")
    with open(locked, "wb") as f:
        f.write(b"x")
    os.chmod(locked, 0)
    assert check_file(ok) is None
    assert check_file(os.path.join(d, "link.jpg")) is None
    assert check_file(os.path.join(d, "broken.jpg")) == "it's a broken link"
    assert check_file(os.path.join(d, "missing.jpg")) == "it no longer exists"
    assert check_file(d) == "it's a folder"
    if os.geteuid() != 0:
        assert check_file(locked) == "permission denied"
    os.chmod(locked, 0o600)
    other = os.path.join(d, "sub")
    os.mkdir(other)
    with open(os.path.join(other, "photo.jpg"), "wb") as f:
        f.write(b"y")
    dup = check_files([ok, os.path.join(other, "photo.jpg")])
    assert dup[ok] is None and dup[os.path.join(other, "photo.jpg")] == "another file chosen has the same name"
    shutil.rmtree(d)

    # Reading omdrop's output.
    assert peer_from_json({"mac": "aa:bb:cc:dd:ee:ff", "rssi": -50, "name": None}) == \
        {"address": "aa:bb:cc:dd:ee:ff", "name": None, "rssi": -50}
    assert peer_from_json({"rssi": -50}) is None
    assert peer_label({"address": "aa:bb:cc:dd:ee:ff", "name": None}) == "Apple device (ee:ff)"
    assert peer_label({"address": "aa:bb:cc:dd:ee:ff", "name": "iPhone"}) == "iPhone"
    assert send_status("Preparing photo.jpg...", "iPhone") == "Preparing photo.jpg…"
    assert send_status("waiting up to 30s for aa:bb to start listening on 8770", "iPhone") == \
        "Waiting for iPhone to wake…"
    assert send_status("sending /x/photo.jpg to aa:bb at [fe80::1]:8770", "iPhone") == \
        "Waiting for iPhone to accept…"
    assert send_status("something else", "iPhone") is None
    assert estimate_progress(0, 100) == 0 and estimate_progress(50, 100) == 0.5
    assert estimate_progress(500, 100) == 0.99 and estimate_progress(5, 0) == 0

    # The ring: a gap at the top, the bar only once there is progress.
    empty, half = ring_svg(0, 32, 14, "#ffffff"), ring_svg(0.5, 32, 14, "#ffffff")
    assert RING_ACCENT not in empty and RING_ACCENT in half
    assert half.count("<path") == len(GLYPH_PATHS) + 2
    start = math.radians(-90 + RING_GAP_DEGREES / 2)
    r = (14 * RING_DIAMETER - 14 * RING_STROKE) / 2
    assert f"M {16 + r * math.cos(start):.3f} {16 + r * math.sin(start):.3f}" in half
    # What uninstall will say it undoes.
    d = tempfile.mkdtemp()
    with open(os.path.join(d, "root"), "w") as f:
        f.write("# before: Linux Mint 22.3, kernel 7.0\npkg git\npkg iw\nnew /usr/lib/omdrop\n"
                "saved /etc/omdrop\nufw\ngone omdrop-owl\n")
    with open(os.path.join(d, "user"), "w") as f:
        f.write("new /home/u/.local/bin/omdrop-tray\nomdrop-cli /home/u/.local/share/omdrop-plugin\n")
    undo, before = ledger_summary((os.path.join(d, "root"), os.path.join(d, "user"), os.path.join(d, "none")))
    assert before == ["Linux Mint 22.3, kernel 7.0"]
    assert undo == ["Removes 2 files and folders it added", "Puts back 1 it replaced",
                    "Removes 2 packages it installed, unless something else needs them",
                    "Removes its firewall rule", "Removes the omdrop command it set up",
                    "Can't bring back the omdrop-owl package it replaced"], undo
    words = ledger_lines((os.path.join(d, "root"), os.path.join(d, "user")))
    assert words[:2] == ["set up the omdrop command in /home/u/.local/share/omdrop-plugin",
                         "added /home/u/.local/bin/omdrop-tray"], words
    assert words[-1] == "installed package git" and "opened TCP 8771 on awdl0 (UFW)" in words
    shutil.rmtree(d)
    print("ok")


SETUP = False


def main():
    global SETUP
    if "--self-test" in sys.argv:
        self_test()
        return 0
    SETUP = "--setup" in sys.argv
    app = Tray()
    if SETUP:
        app.register(None)
        if app.get_is_remote():
            app.activate_action("setup", None)
            return 0
    return app.run([sys.argv[0]])


if __name__ == "__main__":
    sys.exit(main())
